{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mailbox",
  "version": "0.1.12",
  "identifier": "com.thelastmailbox.mailbox",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
