[Unit]
Description=Mailbox hosted WebSocket-to-IMAP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailbox-relay
Group=mailbox-relay
WorkingDirectory=/opt/mailbox
ExecStart=/usr/bin/python3 /opt/mailbox/crates/mailbox-wasm/mailbox-relay.py --listen 127.0.0.1:9001 --target imap.example.com:993 --allowed-host imap.example.com --tls-terminated
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
