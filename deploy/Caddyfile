# Production example for a generated mailbox site and an allow-listed
# mailbox relay. Replace the host names and paths before installing.
#
# The relay is intentionally a separate hostname. Configure fixed destinations
# with --upstream NAME=HOST:PORT. Use the root relay URL for account-based
# selection, or /NAME to restrict a site to one destination.

mail.example.com {
	root * /srv/mailbox-site
	encode gzip
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://relay.example.com wss://relay.example.com; worker-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' https: http: data: blob:; frame-src blob:; base-uri 'none'; form-action 'none'"
	}
	file_server
}

relay.example.com {
	reverse_proxy 127.0.0.1:9001
}
